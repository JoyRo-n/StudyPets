<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_quest_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quest Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tv_quest_difficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_medium"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_quest_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Matematika"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tv_quest_deadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 2024-12-31"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tv_quest_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 50 XP | 🪙 30"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/purple_primary"
            android:layout_marginTop="4dp"/>

        <!-- Status menunggu review — hanya tampil saat status = submitted -->
        <TextView
            android:id="@+id/tv_quest_status_submitted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Bukti terkirim — Menunggu persetujuan admin"
            android:textSize="12sp"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:background="#FFF3E0"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <Button
                android:id="@+id/btn_delete_quest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑️"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:minWidth="48dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_complete_quest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✅ Complete"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_primary"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
