<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════ -->
        <!-- HEADER BANNER — gradient purple         -->
        <!-- ═══════════════════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_login"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Glow circle deco -->
            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_circle_glow"
                android:alpha="0.15"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="-50dp"
                android:layout_marginTop="-50dp"/>

            <!-- Dark mode switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_dark_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:text="🌙"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <!-- Greeting & username -->
            <LinearLayout
                android:id="@+id/ll_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@id/switch_dark_mode"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, Pelajar! 👋"
                    android:textSize="14sp"
                    android:textColor="#BBAAFF"/>

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hero"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <!-- Badge admin — hanya tampil jika isAdmin = true -->
                <TextView
                    android:id="@+id/tv_admin_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 Administrator"
                    android:textSize="12sp"
                    android:textColor="#1A1A1A"
                    android:textStyle="bold"
                    android:background="#FFD740"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Level + Coins row -->
            <LinearLayout
                android:id="@+id/ll_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/ll_greeting"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <!-- Level chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#33FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tv_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Level 1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFD740"/>

                </LinearLayout>

                <!-- Coins chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#33FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tv_coins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪙 100"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFD740"/>

                </LinearLayout>

            </LinearLayout>

            <!-- XP bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@id/ll_stats_row"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="XP Progress"
                        android:textSize="11sp"
                        android:textColor="#BBAAFF"/>

                    <TextView
                        android:id="@+id/tv_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 100 XP"
                        android:textSize="11sp"
                        android:textColor="#BBAAFF"/>

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_xp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#FFD740"
                    android:progressBackgroundTint="#33FFFFFF"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- ═══════════════════════════════════════ -->
        <!-- CONTENT AREA                            -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- DROP MOTIVATION WARNING -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_drop_motivation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF3E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="24sp"
                        android:layout_marginEnd="10dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Drop Motivation!"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#E65100"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pet lapar/sedih — XP jadi setengah! Beri makan petmu dulu."
                            android:textSize="11sp"
                            android:textColor="#BF360C"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ─────────────────────────── -->
            <!-- PET CARD                    -->
            <!-- ─────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐾 Teman Belajarmu"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Pet display row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Pet image with glow background -->
                        <FrameLayout
                            android:layout_width="100dp"
                            android:layout_height="100dp">

                            <View
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:background="@drawable/bg_circle_glow"
                                android:alpha="0.15"
                                android:layout_gravity="center"/>

                            <ImageView
                                android:id="@+id/img_pet_display"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:src="@drawable/pet_cat_new"
                                android:scaleType="fitCenter"
                                android:layout_gravity="center"
                                android:contentDescription="Pet"/>

                        </FrameLayout>

                        <!-- Pet info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tv_pet_name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Mochi 😊"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>

                                <Button
                                    android:id="@+id/btn_rename_pet"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:text="✏️"
                                    android:textSize="14sp"
                                    android:background="@android:color/transparent"
                                    android:padding="0dp"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_pet_mood_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mood: Senang"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👆 Tap untuk berinteraksi!"
                                android:textSize="10sp"
                                android:textColor="@color/purple_primary"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0EAFF"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"/>

                    <!-- Stats grid 2x2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="🍗 Lapar"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"/>

                                </LinearLayout>

                                <ProgressBar
                                    android:id="@+id/pb_hunger"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="8dp"
                                    android:max="100"
                                    android:progress="100"
                                    android:progressTint="@color/orange_accent"
                                    android:progressBackgroundTint="#EEEEEE"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="💧 Haus"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"/>

                                </LinearLayout>

                                <ProgressBar
                                    android:id="@+id/pb_thirst"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="8dp"
                                    android:max="100"
                                    android:progress="100"
                                    android:progressTint="@color/blue_accent"
                                    android:progressBackgroundTint="#EEEEEE"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="❤️ Health"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"/>

                                </LinearLayout>

                                <ProgressBar
                                    android:id="@+id/pb_health"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="8dp"
                                    android:max="100"
                                    android:progress="100"
                                    android:progressTint="#F44336"
                                    android:progressBackgroundTint="#EEEEEE"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="😊 Mood"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"/>

                                </LinearLayout>

                                <ProgressBar
                                    android:id="@+id/pb_mood"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="8dp"
                                    android:max="100"
                                    android:progress="100"
                                    android:progressTint="@color/purple_primary"
                                    android:progressBackgroundTint="#EEEEEE"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ─────────────────────────── -->
            <!-- QUEST SUMMARY               -->
            <!-- ─────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Quest Hari Ini"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="36sp"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_quest_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Aktif | 0 Selesai"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap untuk lihat semua quest →"
                            android:textSize="12sp"
                            android:textColor="@color/purple_primary"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ─────────────────────────── -->
            <!-- MAIN ACTION BUTTONS         -->
            <!-- ─────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Aksi Cepat"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp"/>

            <!-- Belajar & Quiz — highlighted -->
            <Button
                android:id="@+id/btn_belajar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📚  Belajar &amp; Quiz"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_login"
                android:textColor="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="10dp"/>

            <!-- 3 button row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#7C4DFF">

                    <Button
                        android:id="@+id/btn_add_quest"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="➕&#10;Quest"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:gravity="center"/>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF9800">

                    <Button
                        android:id="@+id/btn_feed_pet"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="🍗&#10;Feed Pet"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:gravity="center"/>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#E040FB">

                    <Button
                        android:id="@+id/btn_shop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="🛒&#10;Shop"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:gravity="center"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ─────────────────────────── -->
            <!-- SECONDARY ACTIONS           -->
            <!-- ─────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟 Fitur Lainnya"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <Button
                        android:id="@+id/btn_achievements"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="🏆 Badge"
                        android:textSize="13sp"
                        android:textColor="@color/purple_primary"
                        android:background="@android:color/transparent"/>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <Button
                        android:id="@+id/btn_stats"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="📊 Stats"
                        android:textSize="13sp"
                        android:textColor="@color/purple_primary"
                        android:background="@android:color/transparent"/>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <Button
                        android:id="@+id/btn_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="📅 Jadwal"
                        android:textSize="13sp"
                        android:textColor="@color/purple_primary"
                        android:background="@android:color/transparent"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Logout -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="🚪 Logout"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_secondary"
                android:textColor="#F44336"/>

            <!-- Tombol Admin — hanya tampil jika isAdmin = true (diatur dari MainActivity) -->
            <Button
                android:id="@+id/btn_kelola_user"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="👑 Kelola User (Admin)"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_secondary"
                android:textColor="#7C4DFF"
                android:visibility="gone"/>

            <View android:layout_width="match_parent" android:layout_height="16dp"/>

        </LinearLayout>

    </LinearLayout>

