<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView agar dialog bisa di-scroll saat keyboard muncul -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card_rounded">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Tambah Quest Baru"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/purple_primary"
            android:layout_marginBottom="16dp"/>

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Quest *"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_quest_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Belajar Integral"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <!-- Deskripsi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi (opsional)"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_quest_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Catatan tambahan..."
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:minLines="2"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp"/>

        <!-- Mata Pelajaran -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mata Pelajaran"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/sp_quest_subject"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Kesulitan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kesulitan"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/sp_quest_difficulty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Deadline -->
        <Button
            android:id="@+id/btn_pick_deadline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📅 Pilih Deadline"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_deadline_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/purple_primary"
            android:layout_marginBottom="20dp"/>

        <!-- Tombol aksi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_cancel_quest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batal"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_save_quest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simpan ✅"
                android:background="@drawable/bg_btn_primary"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
