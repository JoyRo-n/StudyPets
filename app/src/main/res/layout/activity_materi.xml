<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/purple_primary">

        <Button
            android:id="@+id/btn_back_materi"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 Pilih Materi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih materi yang ingin kamu pelajari:"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"/>

            <!-- Baris 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_materi_matematika"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="➕\nMatematika"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_materi_fisika"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="⚡\nFisika"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

            <!-- Baris 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_materi_kimia"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="🧪\nKimia"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_materi_biologi"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="🌿\nBiologi"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

            <!-- Baris 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_materi_bind"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="📝\nBahasa\nIndonesia"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/purple_primary"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_materi_bing"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="🌍\nBahasa\nInggris"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/purple_primary"/>

            </LinearLayout>

            <!-- Baris 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_materi_sejarah"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="🏛️\nSejarah"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/purple_primary"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_materi_geografi"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="🗺️\nGeografi"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/purple_primary"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
