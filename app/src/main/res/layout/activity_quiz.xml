<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/purple_primary">

        <TextView
            android:id="@+id/tv_nomor_soal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Soal 1 dari 10"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tv_progress_quiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Benar: 0"
            android:textSize="14sp"
            android:textColor="@color/yellow_accent"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card soal -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/tv_pertanyaan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="Pertanyaan..."
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="4dp"/>

            </androidx.cardview.widget.CardView>

            <!-- Layout untuk soal PILIHAN GANDA -->
            <LinearLayout
                android:id="@+id/layout_pilihan_ganda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- RadioGroup = group tombol radio, hanya satu yang bisa dipilih -->
                <RadioGroup
                    android:id="@+id/rg_pilihan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A. Pilihan A"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_card_rounded"/>

                    <RadioButton
                        android:id="@+id/rb_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B. Pilihan B"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_card_rounded"/>

                    <RadioButton
                        android:id="@+id/rb_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="C. Pilihan C"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_card_rounded"/>

                    <RadioButton
                        android:id="@+id/rb_d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="D. Pilihan D"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_card_rounded"/>

                </RadioGroup>

            </LinearLayout>

            <!-- Layout untuk soal ISIAN -->
            <LinearLayout
                android:id="@+id/layout_isian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ketik jawabanmu:"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_jawaban_isian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Jawaban..."
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:inputType="text"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Tombol selanjutnya di bagian bawah -->
    <Button
        android:id="@+id/btn_selanjutnya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selanjutnya →"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_primary"
        android:textColor="#FFFFFF"
        android:layout_margin="16dp"/>

</LinearLayout>
