<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FF9800">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_back_admin_quest"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 Buat Quest untuk User"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lihat riwayat belajar user lalu buatkan quest"
            android:textSize="12sp"
            android:textColor="#FFF3E0"
            android:layout_marginTop="4dp"
            android:layout_marginStart="48dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Pilih User -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Pilih User Target"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinner_user"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <!-- Rekap Riwayat Belajar User -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Riwayat Belajar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_riwayat_belajar"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/tv_no_riwayat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada riwayat belajar untuk user ini"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"/>

            <!-- Form Buat Quest -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Buat Quest"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <!-- Judul Quest -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Quest"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_judul_quest"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Contoh: Kerjakan latihan soal Matematika"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:inputType="text"
                android:singleLine="true"/>

            <!-- Deskripsi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deskripsi"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_deskripsi_quest"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:hint="Deskripsi tugas yang harus diselesaikan"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:inputType="textMultiLine"
                android:gravity="top"/>

            <!-- Mapel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mata Pelajaran"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinner_mapel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <!-- Kesulitan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tingkat Kesulitan"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinner_kesulitan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <!-- Deadline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deadline"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/btn_pilih_deadline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📅 Pilih Tanggal Deadline"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null"/>

            <!-- Info reward -->
            <TextView
                android:id="@+id/tv_info_reward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Reward: Medium → 30 XP + 50 🪙"
                android:textSize="12sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:background="#FFF3E0"
                android:padding="8dp"/>

            <!-- Tombol buat quest -->
            <Button
                android:id="@+id/btn_buat_quest_admin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="📋 Kirim Quest ke User"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF9800"
                android:stateListAnimator="@null"/>

            <View android:layout_width="match_parent" android:layout_height="16dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
