<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/pet_cat">

    <!-- Animasi ekor bergoyang -->
    <target
        android:name="tail"
        android:animation="@animator/cat_tail_wag"/>

    <!-- Animasi mata kiri berkedip -->
    <target
        android:name="eye_left"
        android:animation="@animator/cat_blink"/>

    <!-- Animasi mata kanan berkedip -->
    <target
        android:name="eye_right"
        android:animation="@animator/cat_blink"/>

</animated-vector>
