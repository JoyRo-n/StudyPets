<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/pet_dog">

    <!-- Animasi ekor bergoyang cepat seperti anjing -->
    <target
        android:name="tail"
        android:animation="@animator/dog_tail_wag"/>

    <!-- Animasi telinga kiri bergoyang -->
    <target
        android:name="ear_left"
        android:animation="@animator/cat_tail_wag"/>

    <!-- Animasi lidah naik turun -->
    <target
        android:name="tongue"
        android:animation="@animator/pet_float"/>

</animated-vector>
